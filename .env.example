ANTHROPIC_API_KEY=
PORT=3001

# Set to false to turn Tutor mode off.
TUTOR_ENABLED=true

# The tutor's voice in voice mode: "browser" (the browser's built-in speech, the default) or
# "elevenlabs" (needs ELEVENLABS_API_KEY). Restart the server after changing these.
TUTOR_VOICE_PROVIDER=browser
ELEVENLABS_API_KEY=
# Optional. Defaults to "George" (JBFqnCBsd6RMkjVDRZzb).
ELEVENLABS_VOICE_ID=
